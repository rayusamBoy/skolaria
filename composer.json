{
    "name": "rayusamboy/skolaris",
    "type": "project",
    "description": "Multi-tenant, offline-ready school management platform",
    "keywords": ["skolaris", "multi-tenant", "school-management", "progressive-web-app", "offline-ready"],
    "license": "AGPL-3.0",
    "require": {
        "php": "^8.4",
        "bacon/bacon-qr-code": "^2.0",
        "cmgmyr/messenger": "^2.30",
        "diglactic/laravel-breadcrumbs": "^10.1",
        "dompdf/dompdf": "^3.1",
        "erusev/parsedown": "^1.7",
        "guzzlehttp/guzzle": "^7.9",
        "hashids/hashids": "^5.0",
        "iksaku/laravel-mass-update": "^2.0",
        "jenssegers/agent": "^2.6",
        "ksubileau/color-thief-php": "^2.0",
        "laravel-notification-channels/fcm": "^6.1",
        "laravel/framework": "^13.0",
        "laravel/reverb": "@beta",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.5",
        "laravel/vonage-notification-channel": "^3.3",
        "maatwebsite/excel": "^3.1",
        "nnjeim/world": "^1.1",
        "opcodesio/log-viewer": "^3.10",
        "pragmarx/google2fa-laravel": "^3.0",
        "pragmarx/google2fa-qrcode": "^3.0",
        "pragmarx/recovery": "^0.2.1",
        "pusher/pusher-php-server": "^7.2",
        "silviolleite/laravelpwa": "^2.0",
        "spatie/browsershot": "^5.3",
        "spatie/image": "^3.9",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-analytics": "^5.3",
        "spatie/laravel-permission": "^6.19",
        "stancl/tenancy": "dev-master"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.5",
        "fakerphp/faker": "^1.23",
        "fruitcake/laravel-debugbar": "^4.1",
        "kitloong/laravel-migrations-generator": "^7.0",
        "laravel/boost": "^2.4",
        "laravel/pint": "^1.31",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "orangehill/iseed": "^3.0",
        "phpunit/phpunit": "^11.0.1",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
